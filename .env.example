# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary CDN Image Hosting
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AI Assistant
GEMINI_API_KEY=your-gemini-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY (TEST & LIVE KEYS)
# ==============================================================================
# Active Mode: "test" or "live" (switch anytime from /admin-razorpay)
RAZORPAY_MODE=test

# Razorpay Test Credentials (get from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID_TEST=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET_TEST=YOUR_TEST_KEY_SECRET

# Razorpay Live Credentials (get from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID_LIVE=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET_LIVE=YOUR_LIVE_KEY_SECRET

# Public Key ID fallback exposed to client-side checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID

# WhatsApp Order Notification Target Phone Number
ORDER_NOTIFY_WHATSAPP=8527296771
